server {
    listen 80;
    server_name loja.cafeplanalto.lab localhost _;

    root /usr/share/nginx/html;
    index index.html;

    location = / {
        try_files /index.html =404;
    }

    location = /index.html {
        try_files /index.html =404;
    }

    location ~ ^/(produtos|pedidos|health|admin/caos|docs|redoc|openapi\.json) {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Trace-Id $req_trace_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
        add_header X-Trace-Id $req_trace_id always;
    }
}

server {
    listen 8080;
    server_name _;

    location = /nginx_status {
        stub_status on;
        access_log off;
    }

    location = /healthz {
        return 200 "ok\n";
        access_log off;
    }
}
