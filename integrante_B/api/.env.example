# Endereço de bind do servidor HTTP (padrão: 0.0.0.0)
APP_HOST=

# Porta HTTP da API (padrão: 8000)
APP_PORT=

# Nível mínimo dos logs JSON: DEBUG, INFO, WARNING, ERROR (padrão: INFO)
LOG_LEVEL=

# String de conexão PostgreSQL (opcional na Semana 1; vazio usa armazenamento em memória)
DATABASE_URL=

# Tamanho mínimo do pool de conexões PostgreSQL (padrão: 1)
DB_POOL_MIN_SIZE=

# Tamanho máximo do pool de conexões PostgreSQL (padrão: 5)
DB_POOL_MAX_SIZE=

# Timeout em segundos para abertura de conexão TCP com o PostgreSQL (padrão: 2)
DB_CONNECT_TIMEOUT=

# Timeout em segundos para obter uma conexão livre do pool (padrão: 3.0)
DB_POOL_TIMEOUT=

# Número máximo de tentativas para inicializar o schema no startup (padrão: 10)
DB_INIT_RETRIES=

# Intervalo em segundos entre tentativas de inicialização do schema (padrão: 1.0)
DB_INIT_RETRY_DELAY=
