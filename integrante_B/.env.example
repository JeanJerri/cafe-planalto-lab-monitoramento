# Nome do banco PostgreSQL local (padrão: cafeplanalto)
POSTGRES_DB=

# Usuário do PostgreSQL local (padrão: cafe)
POSTGRES_USER=

# Senha do PostgreSQL local (defina ou deixe em branco para usar padrão dev: cafeplanalto123)
POSTGRES_PASSWORD=

# Nível dos logs JSON da API (padrão: INFO)
API_LOG_LEVEL=

# Taxa de requisições por segundo do gerador de carga k6 (faixa exigida: 5 a 20; padrão: 10)
LOADGEN_TARGET_RPS=

# Porta local do Nginx (loja), evitando conflito com Zabbix na porta 8080 (padrão: 8088)
WEB_HOST_PORT=

# Porta local do stub_status do Nginx (padrão: 8089)
WEB_STATUS_HOST_PORT=

# Porta local direta da API FastAPI para diagnóstico e Swagger (padrão: 8000)
API_HOST_PORT=
