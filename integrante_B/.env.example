# Nome do banco PostgreSQL local (padrão: cafeplanalto)
POSTGRES_DB=

# Usuário do PostgreSQL local (padrão: cafe)
POSTGRES_USER=

# Senha do PostgreSQL local (defina ou deixe em branco para usar padrão dev: cafeplanalto123)
POSTGRES_PASSWORD=

# Nível dos logs JSON da API (padrão: INFO)
API_LOG_LEVEL=

# Taxa de requisições por segundo do gerador de carga k6 (faixa exigida: 5 a 20; padrão: 10)
LOADGEN_TARGET_RPS=

# Porta local do Nginx (loja), evitando conflito com Zabbix na porta 8080 (padrão: 8088)
WEB_HOST_PORT=

# Porta local do stub_status do Nginx (padrão: 8089)
WEB_STATUS_HOST_PORT=

# Porta local direta da API FastAPI para diagnóstico e Swagger (padrão: 8000)
API_HOST_PORT=

# Porta local do Prometheus (padrão: 9090)
PROMETHEUS_HOST_PORT=

# Porta local do Alertmanager (padrão: 9093)
ALERTMANAGER_HOST_PORT=

# Porta local do Blackbox Exporter (padrão: 9115)
BLACKBOX_HOST_PORT=

# Porta local do cAdvisor, evitando conflito com Zabbix na porta 8080 (padrão: 8085)
CADVISOR_HOST_PORT=

# Servidor SMTP para envio de alertas por e-mail (ex.: smtp.gmail.com:587)
SMTP_SMARTHOST=

# Endereço remetente exibido nos e-mails de alerta (ex.: seu.email@gmail.com)
SMTP_FROM=

# Usuário de autenticação SMTP (no Gmail, o mesmo e-mail remetente)
SMTP_AUTH_USERNAME=

# Senha SMTP ou Senha de App (16 caracteres no Gmail com verificação em 2 etapas)
SMTP_AUTH_PASSWORD=

# Exige TLS na conexão SMTP (padrão: true)
SMTP_REQUIRE_TLS=

# Endereço de destino que receberá os alertas no celular/caixa de entrada
ALERT_EMAIL_TO=
